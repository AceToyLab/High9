<body>

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="card-wrapper" id="content">
    <div class="loading">✦ loading ✦</div>
  </div>

  <script>
    // ============================================================
    // CONFIGURATION — change nothing here, edit messages.json only
    // ============================================================
    const MESSAGES_FILE = 'messages.json';

    // ============================================================
    let currentUtterance = null;
    let isPlaying = false;

    async function loadAndRender() {
      try {
        const response = await fetch(MESSAGES_FILE);
        const messages = await response.json();

        // Pick a random message
        const random = messages[Math.floor(Math.random() * messages.length)];

        // Update CSS variables for this message's colors
        document.documentElement.style.setProperty('--accent', random.accent);
        document.querySelector('.blob-1').style.background = random.background;
        document.querySelector('.blob-2').style.background = random.accent;

        // Render
        const container = document.getElementById('content');
        container.innerHTML = `
          <div class="deco-line"></div>
          <div class="category">${random.category}</div>
          <div class="card">
            <span class="quote-mark">"</span>
            <p class="message">${random.message}</p>
            <div class="card-divider"></div>
            <div class="message-number">message ${random.id} of ${messages.length}</div>
          </div>
          <button class="play-btn" id="playBtn" onclick="toggleSpeech('${random.message.replace(/'/g, "\\'")}')">
            <svg id="playIcon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <div class="hint">tap to listen</div>
          <button class="another" onclick="location.reload()">✦ another message ✦</button>
        `;

      } catch (e) {
        document.getElementById('content').innerHTML = '<div class="loading">something went wrong</div>';
        console.error(e);
      }
    }

    function toggleSpeech(text) {
      const btn = document.getElementById('playBtn');
      const icon = document.getElementById('playIcon');

      if (isPlaying) {
        // Stop
        window.speechSynthesis.cancel();
        isPlaying = false;
        btn.classList.remove('playing');
        icon.innerHTML = '<path d="M8 5v14l11-7z"/>';
        return;
      }

      // Play
      window.speechSynthesis.cancel(); // cancel any previous
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 0.85;
      utterance.pitch = 1.05;
      utterance.volume = 1;

      // Try to pick a nice voice
      const voices = window.speechSynthesis.getVoices();
      const preferred = voices.find(v => v.name.includes('Samantha') || v.name.includes('Karen') || v.name.includes('Alex'));
      if (preferred) utterance.voice = preferred;

      utterance.onend = () => {
        isPlaying = false;
        btn.classList.remove('playing');
        icon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      };
      utterance.onerror = () => {
        isPlaying = false;
        btn.classList.remove('playing');
        icon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      };

      isPlaying = true;
      btn.classList.add('playing');
      icon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
      window.speechSynthesis.speak(utterance);
    }

    // Load voices first (required on some browsers), then render
    if (window.speechSynthesis) {
      window.speechSynthesis.getVoices();
      if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = loadAndRender;
      }
    }
    loadAndRender();
  </script>

